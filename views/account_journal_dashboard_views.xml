<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_dashboard_kanban_stripe" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit.stripe</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <!-- Expose the computed field to the kanban controller -->
            <xpath expr="//field[@name='show_refresh_out_einvoices_status_button']" position="after">
                <field name="show_stripe_fetch_button"/>
            </xpath>

            <!-- Add Fetch button inside the sale journal primary left column -->
            <xpath expr="//t[@t-name='JournalBodySalePurchase']//div[@name='kanban_primary_left']" position="inside">
                <t t-if="journal_type == 'sale' and record.show_stripe_fetch_button.raw_value">
                    <button type="object" name="action_stripe_fetch_invoices"
                            class="btn btn-secondary ms-1"
                            groups="stripe_connector.group_stripe_user">
                        Fetch Stripe Invoices
                    </button>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
