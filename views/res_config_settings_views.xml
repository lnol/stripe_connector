<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_stripe" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stripe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Stripe" id="stripe_connector_settings"
                       groups="stripe_connector.group_stripe_admin">
                    <setting string="Stripe Integration"
                             help="Configure Stripe accounts to fetch invoices and credit notes automatically.">
                        <div class="content-group mt8">
                            <button name="%(stripe_connector.action_stripe_account)d"
                                    type="action"
                                    string="Manage Stripe Accounts"
                                    class="btn-link"
                                    icon="oi-arrow-right"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
