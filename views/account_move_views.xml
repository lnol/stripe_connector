<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_stripe" model="ir.ui.view">
        <field name="name">account.move.form.inherit.stripe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//group[@name='sale_info_group']" position="inside">
                <field name="stripe_invoice_id"
                       readonly="1"
                       invisible="not stripe_invoice_id"/>
            </xpath>
        </field>
    </record>
</odoo>
