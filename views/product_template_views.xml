<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_stripe" model="ir.ui.view">
        <field name="name">product.template.form.inherit.stripe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Stripe"
                       invisible="not stripe_product_id"
                       groups="stripe_connector.group_stripe_user">
                    <field name="stripe_product_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
