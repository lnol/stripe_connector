<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_stripe_fetch_invoices" model="ir.cron">
            <field name="name">Stripe: Queue Invoice Fetches</field>
            <field name="model_id" ref="stripe_connector.model_stripe_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_queue_all_fetches()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="cron_stripe_process_fetch_queue" model="ir.cron">
            <field name="name">Stripe: Process Invoice Fetch Queue</field>
            <field name="model_id" ref="stripe_connector.model_stripe_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_fetch_queue()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
